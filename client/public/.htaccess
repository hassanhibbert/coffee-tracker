# Apache config for DreamHost. Vite copies public/ into dist/, so this ships with every
# deploy. It does what a static host's rewrite and header settings would otherwise do.

# Single-page app: /brews/12/edit has no file on disk; serve index.html and let
# React Router render the page. Real files (JS, CSS, icons) are served as-is.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Defence in depth for the token in sessionStorage: even if markup were injected,
  # the browser refuses to run scripts or send data anywhere but these origins.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://hassan-coffee-tracker-api.onrender.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # index.html must be revalidated so a new deploy is picked up right away. Files in
  # assets/ have a content hash in their name, so they can be cached forever.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
