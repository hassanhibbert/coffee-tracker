# Copy to .env.deploy.local and fill in. *.local is gitignored, so real values are safe there.

# DreamHost shell user (Panel > Websites > Manage Websites > the site > SFTP/SSH user).
DEPLOY_USER=
# The <server>.dreamhost.com host shown for that user, or the domain itself.
DEPLOY_HOST=
# The folder DreamHost serves for coffee.hassanhibbert.com, usually /home/<user>/coffee.hassanhibbert.com.
# Must be dedicated to this site: the deploy uses rsync --delete.
DEPLOY_PATH=

# Public value, baked into the JavaScript bundle at build time.
VITE_API_BASE_URL=https://hassan-coffee-tracker-api.onrender.com
